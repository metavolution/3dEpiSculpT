// Educational Annotation: 4D Hypercomplex Quaternion Vectorized Operations
#ifndef EPI_QUATERNION_CLH
#define EPI_QUATERNION_CLH

#include "EpiMath.clh"

// Quaternion layout: float4(w, x, y, z) where w is real (q.x), and (x,y,z) are imaginary (q.yzw)
inline float4 epi_quat_mul(float4 q1, float4 q2) {
    return (float4)(
        q1.x * q2.x - q1.y * q2.y - q1.z * q2.z - q1.w * q2.w,
        q1.x * q2.y + q1.y * q2.x + q1.z * q2.w - q1.w * q2.z,
        q1.x * q2.z - q1.y * q2.w + q1.z * q2.x + q1.w * q2.y,
        q1.x * q2.w + q1.y * q2.z - q1.z * q2.y + q1.w * q2.x
    );
}

inline float4 epi_quat_square(float4 q) {
    float vSq = q.y * q.y + q.z * q.z + q.w * q.w;
    return (float4)(q.x * q.x - vSq, 2.0f * q.x * q.y, 2.0f * q.x * q.z, 2.0f * q.x * q.w);
}

inline float4 epi_quat_conj(float4 q) {
    return (float4)(q.x, -q.y, -q.z, -q.w);
}

inline float epi_quat_norm_sq(float4 q) {
    return dot(q, q);
}

inline float epi_quat_norm(float4 q) {
    return length(q);
}

inline float4 epi_quat_exp(float4 q) {
    float expW = exp(q.x);
    float vNorm = length(q.yzw);
    if (vNorm < 1e-7f) {
        return (float4)(expW, 0.0f, 0.0f, 0.0f);
    }
    float coeff = expW * sin(vNorm) / vNorm;
    return (float4)(expW * cos(vNorm), q.y * coeff, q.z * coeff, q.w * coeff);
}

#endif

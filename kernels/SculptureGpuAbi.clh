// OpenCL mirror of SculptureGpuAbi.h. Keep literal IDs, field order, and byte
// sizes synchronized. This file defines data only; kernel ownership arrives in
// the application OpenCL backend rather than mGFX.

#ifndef EPI_SCULPTURE_GPU_ABI_CLH
#define EPI_SCULPTURE_GPU_ABI_CLH

#define EPI_SCULPT_ABI_VERSION 1u

#define EPI_SCULPT_VOLUME_GRID_SIZE 50u
#define EPI_SCULPT_VOLUME_VOXEL_COUNT 125000u
#define EPI_SCULPT_VOLUME_MACRO_SIZE 10u
#define EPI_SCULPT_VOLUME_MACRO_BLOCK_COUNT 125u


#define EPI_SCULPT_COLOR_PHENOMENOLOGICAL_PALETTE 11u
#define EPI_SCULPT_COLOR_OP_ART_ISOLUMINANCE 12u
#define EPI_SCULPT_COLOR_KINETIC_VELOCITY 13u
#define EPI_SCULPT_COLOR_GEOMETRIC_CURVATURE 14u
#define EPI_SCULPT_COLOR_BIOLUMINESCENCE 15u

#define EPI_SCULPT_SEED_FIBONACCI_PHYLLOTAXIS 15u

typedef struct SculptureProgramParamsGpu {
    uint abi_version;
    uint byte_size;
    ushort inner_id;
    ushort inner_idB;
    ushort reduction_id;
    ushort reduction_idB;

    ushort output_mode;
    ushort output_modeB;
    ushort seed_id;
    ushort seed_idB;
    ushort color_effect_id;
    ushort enable4D;

    uint stageMask;
    uint feedback_iterations;
    uint sample_count;
    float latent_w;
    float topologyBlend;

    float4 pre_affine;
    float4 post_affine;
    float4 dynamics_seed;
    float4 pulse_material;
    float4 output_scale;
    float4 kinetic_flow;
    float4 audio_spectrum;
    uint auxiliary_resolution_scale;
    uint attractor_mode;
    float attractor_strength;
    float chroma_breath;
    float luma_drift;
    float rotor_alpha;
    float rotor_beta;
    float rotor_theta_4d;
    float4 optical_volumetric;
    float4 temporal_control;
} SculptureProgramParamsGpu;

typedef struct SculptureFrameGpu {
    uint abi_version;
    uint byte_size;
    uint sample_count;
    uint generation;

    float time;
    float morph;
    float delta_seconds;
    float reserved_f32;
} SculptureFrameGpu;

typedef struct SculptureSampleGpu {
    float4 position_radius;
    float4 color_tint;
    float4 normal_vector;
    float4 velocity;
    uint materialRole;
    uint reserved0;
    uint reserved1;
    uint reserved2;
} SculptureSampleGpu;

typedef struct SculptureAnalyticsGpu {
    uint activeInstanceCount;
    uint generation;
    float totalOrbit;
    float totalKineticEnergy;

    float boundsMin[3];
    float averageSpeed;

    float boundsMax[3];
    float reserved;
} SculptureAnalyticsGpu;

inline int epi_sculpt_program_abi_valid(
    const __constant SculptureProgramParamsGpu* params) {
    return params->abi_version == EPI_SCULPT_ABI_VERSION
        && params->byte_size == 224u;
}

inline int epi_sculpt_frame_abi_valid(
    const __constant SculptureFrameGpu* frame) {
    return frame->abi_version == EPI_SCULPT_ABI_VERSION
        && frame->byte_size == 32u;
}

#endif // EPI_SCULPTURE_GPU_ABI_CLH
